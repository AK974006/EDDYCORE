## Example environment variables for Cloud OS
# Copy this file to `.env` and fill in the real secret values before running.

# Supabase project URL (leave as-is if using the included project)
SUPABASE_URL=https://ukjofmkyobtdrzovwfcg.supabase.co

# Supabase API key - use a project anon or service_role key as appropriate
SUPABASE_KEY=

# Supabase storage bucket name
SUPABASE_BUCKET=ak


# Node environment for frontend/electron
NODE_ENV=development
# Supabase (optional) - if not provided, the app will use local filesystem storage
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Node environment for electron/frontend
NODE_ENV=development
